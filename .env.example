# IMPORTANT: This file contains sensitive information and should NEVER be committed to Git
# The .gitignore file is configured to prevent this file from being tracked

# Flask Configuration
FLASK_SECRET_KEY="whatever-your-flask-secret-key-is"

# OpenAI Configuration  
OPENAI_API_KEY="whatever-your-openai-api-key-is"

# Optional: Deployment Configuration
# DEPLOYMENT_ENV=render
# GITHUB_TOKEN=your-github-token-for-deployments

# SECURITY NOTES:
# 1. Always use strong, random values for FLASK_SECRET_KEY
# 2. Never share your OpenAI API key
# 3. Never commit this file to version control
# 4. Use environment variables in production deployments
